# Application Security & Tokens
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Primary Administrator Credentials (idempotently ensured on startup)
ADMIN_EMAIL=admin@local.com
ADMIN_PASSWORD=admin

# Seeding & Environment
AUTO_SEED=True
DEBUG=False
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# PostgreSQL Database Settings
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=tracker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Database Connection URL
DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5432/tracker

# SQLite (for local testing):
# DATABASE_URL=sqlite:///./tracker.db
