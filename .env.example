# PostgreSQL Database Settings
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=tracker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Database Connection URL
# Для локального запуска бэкенда при работающем контейнере PostgreSQL:
DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5432/tracker

# Для запуска внутри Docker Compose (хост 'db'):
# DATABASE_URL=postgresql+psycopg://tracker:tracker@db:5432/tracker

# Для легковесного локального тестирования на SQLite:
# DATABASE_URL=sqlite:///./tracker.db

# Application Settings
DEBUG=False
