# PostgreSQL Database Settings
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=tracker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Database Connection URL
# For local backend run with active PostgreSQL container:
DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5432/tracker

# For running inside Docker Compose ('db' service host):
# DATABASE_URL=postgresql+psycopg://tracker:tracker@db:5432/tracker

# For lightweight local testing on SQLite:
# DATABASE_URL=sqlite:///./tracker.db

# Application Settings
DEBUG=False
